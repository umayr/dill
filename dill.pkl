module dill

class Port {
  target: Int
  published: Int?
  protocol: "tcp" | "udp" | "sctp" = "tcp"
  hostIp: String?
}

class Mount {
  type: "volume" | "bind" | "tmpfs" = "volume"
  source: String?
  target: String
  readOnly: Boolean = false

  /// Use an existing volume as-is: no stack prefix, no creation, labelling, or
  /// removal by teardown. `source` or `name` is the engine volume name.
  externalVolume: Boolean = false

  /// Explicit engine volume name. Unless `externalVolume` is true, Dill creates
  /// missing volumes with ownership labels. Teardown retains stack-labelled
  /// volumes and reports an error even with `--force`; pre-existing unlabelled
  /// volumes are left untouched. Remove volumes manually only after verifying
  /// ownership and preventing concurrent changes. When omitted, named volumes are
  /// prefixed with the stack name: `pg-data` becomes `<stack>_pg-data`.
  name: String?
}

class HealthCheck {
  test: List<String> | String
  interval: Duration?
  timeout: Duration?
  retries: Int?
  startPeriod: Duration?
}

class Service {
  image: String
  containerName: String?
  restart: "no" | "always" | "on-failure" | "unless-stopped" = "no"
  pullPolicy: "always" | "missing" | "never" = "missing"
  environment: Mapping<String, String>?
  volumes: List<Mount | String>?
  ports: List<Port | String>?
  labels: Mapping<String, String>?
  dependsOn: List<String>?
  command: List<String>?
  networkMode: String?
  healthcheck: HealthCheck?
  user: String?
  init: Boolean?
  capAdd: List<String>?
  devices: List<String>?
  cpuset: String?

  /// Hard memory limit (for example "512m", "1g", "1.5g").
  memLimit: String?

  /// Soft memory reservation.
  memReservation: String?

  /// CPU limit as a decimal fraction of one core (for example "0.5" or "1.5").
  /// Rounded down to 0.00001-core precision for identical engine quotas.
  cpus: String?

  /// Relative CPU weight (Docker --cpu-shares).
  cpuShares: Int?

  /// Maximum number of PIDs; -1 means unlimited.
  pidsLimit: Int?
}

class DillConfig {
  /// Stack name used for container labels and network naming.
  /// When omitted, a deterministic adjective-animal name is derived from the config file path.
  name: String?
  services: Mapping<String, Service>
  /// Specify the container engine to use for this deployment
  engine: "podman" | "docker" = "podman"
}

config: DillConfig

output {
  // Pkl's JSON renderer cannot serialise Duration natively.
  // Convert to {value, unit} so the Go side can reconstruct time.Duration.
  renderer = new JsonRenderer {
    converters {
      [Duration] = (d) -> new Dynamic { ["value"] = d.value; ["unit"] = d.unit }
    }
  }
}
