module dill

class Port {
  target: Int
  published: Int?
  protocol: "tcp" | "udp" | "sctp" = "tcp"
  hostIp: String?
}

class Mount {
  type: "volume" | "bind" | "tmpfs" = "volume"
  source: String?
  target: String
  readOnly: Boolean = false

  /// Use an existing volume as-is: no stack prefix, no creation, labelling, or
  /// removal by teardown. `source` or `name` is the engine volume name.
  externalVolume: Boolean = false

  /// Explicit engine volume name. The volume stays managed (created, labelled,
  /// and removed) unless `externalVolume` is true. When omitted, named volumes are
  /// prefixed with the stack name: `pg-data` becomes `<stack>_pg-data`.
  name: String?
}

class HealthCheck {
  test: List<String> | String
  interval: Duration?
  timeout: Duration?
  retries: Int?
  startPeriod: Duration?
}

class Service {
  image: String
  containerName: String?
  restart: "no" | "always" | "on-failure" | "unless-stopped" = "no"
  pullPolicy: "always" | "missing" | "never" = "missing"
  environment: Mapping<String, String>?
  volumes: List<Mount | String>?
  ports: List<Port | String>?
  labels: Mapping<String, String>?
  dependsOn: List<String>?
  command: List<String>?
  networkMode: String?
  healthcheck: HealthCheck?
  user: String?
  init: Boolean?
  capAdd: List<String>?
  devices: List<String>?
  cpuset: String?
}

class DillConfig {
  /// Stack name used for container labels and network naming.
  /// When omitted, a deterministic adjective-animal name is derived from the config file path.
  name: String?
  services: Mapping<String, Service>
  /// Specify the container engine to use for this deployment
  engine: "podman" | "docker" = "podman"
}

config: DillConfig

output {
  // Pkl's JSON renderer cannot serialise Duration natively.
  // Convert to {value, unit} so the Go side can reconstruct time.Duration.
  renderer = new JsonRenderer {
    converters {
      [Duration] = (d) -> new Dynamic { ["value"] = d.value; ["unit"] = d.unit }
    }
  }
}
