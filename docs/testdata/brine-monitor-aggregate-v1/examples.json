  "parserCases": [
    {
      "id": "request-header-edge",
      "condition": "8,192 decoded header bytes under the field-count formula, otherwise valid.",
      "expect": "admit-if-available"
    },
    {
      "id": "request-header-over",
      "condition": "8,193 decoded header bytes including duplicate fields.",
      "expect": "431-or-close-no-acquisition"
    },
    {
      "id": "response-header-edge",
      "condition": "8,192 decoded response header bytes, otherwise valid.",
      "expect": "continue-bounded-verification"
    },
    {
      "id": "response-header-over",
      "condition": "8,193 decoded response header bytes, on success or error.",
      "expect": "retire-and-stop"
    },
    {
      "id": "request-body-edge",
      "condition": "512-byte decoded JSON body including allowed whitespace, otherwise valid.",
      "expect": "admit-if-available"
    },
    {
      "id": "response-body-edge",
      "condition": "4,096 literal fixed-length response bytes including signed whitespace, otherwise valid.",
      "expect": "continue-bounded-verification"
    },
    {
      "id": "response-body-over",
      "condition": "4,097 bytes on success or error.",
      "expect": "retire-and-stop"
    },
    {
      "id": "encoded-request",
      "condition": "A Content-Encoding field is present, even identity.",
      "expect": "reject-before-acquisition"
    },
    {
      "id": "encoded-reply",
      "condition": "Extension peer sends a content-coded reply.",
      "expect": "reject-without-decompressing-retire-and-stop"
    },
    {
      "id": "duplicate-request-header",
      "condition": "Two identical binding headers with different name casing.",
      "expect": "reject-before-acquisition"
    },
    {
      "id": "folded-request-header",
      "condition": "Comma-joined epoch values in one field.",
      "expect": "reject-before-acquisition"
    },
    {
      "id": "duplicate-proof-header",
      "condition": "Two identical signature headers on otherwise valid success.",
      "expect": "retire-and-stop"
    },
    {
      "id": "folded-proof-header",
      "condition": "Comma-joined proof values in one field.",
      "expect": "retire-and-stop"
    },
    {
      "id": "ambiguous-reply-framing",
      "condition": "Reply contains duplicate length fields.",
      "expect": "retire-and-stop"
    },
    {
      "id": "oversize-depth",
      "condition": "Input descends to a fifth nested array or object.",
      "expect": "reject-before-acquisition"
    }
  ],
  "recoveryCases": [
    {
      "id": "stock-non-200",
