// Runnable Pkl authoring fixture only; current Dill cannot apply this model.
import "Model.pkl"
import "Postgres.pkl"

local first = new Postgres.Component {
  name = "catalog"
  database = "catalog"
  storage = "catalog-data"
  password = "catalog-password"
}
local second = new Postgres.Component {
  name = "metrics"
  database = "metrics"
  storage = "metrics-data"
  password = "metrics-password"
}

// Amend the component result before insertion; no positional list patching.
local catalogService = (first.service) {
  resources { memory = 512.mib }
}

deployment = new Model.Deployment {
  target = "lab"
  application {
    name = "two-databases"
    storage {
      new { name = "catalog-data" }
      new { name = "metrics-data" }
    }
    secrets {
      new { name = "catalog-password" }
      new { name = "metrics-password" }
    }
    services {
      catalogService
      second.service
    }
    jobs {
      new {
        name = "initialize"
        image = "postgres:17"
        dependencies {
          new { node = "catalog"; condition = "healthy" }
        }
        // Harmless illustration, not database initialization logic.
        process { entrypoint = List("/bin/sh", "-ec"); args = List("exit 0") }
        trigger = "manual"
      }
    }
  }
  bindings {
    storage {
      new Model.ExistingVolume { name = "catalog-data"; volume = "existing-catalog-data" }
      new Model.ExistingVolume { name = "metrics-data"; volume = "existing-metrics-data" }
    }
    secrets {
      new { name = "catalog-password"; provider = "host-files"; key = "catalog/password" }
      new { name = "metrics-password"; provider = "host-files"; key = "metrics/password" }
    }
  }
}

output {
  value = deployment
  renderer = Model.renderer
}
