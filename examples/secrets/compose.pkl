amends "../../dill.pkl"

// References only: the operator provisions immutable HOST FILE sources.
// Checked delivery requires trusted target/stack/engine/socket and private bindings/policy.
config {
  name = "demo"
  engine = "docker"
  secrets {
    new { name = "db-password" }
  }
  services {
    ["app"] {
      image = "alpine:3"
      secrets {
        new {
          name = "db-password"
          target = "/run/secrets/db-password"
        }
      }
    }
  }
}
