amends "../../dill.pkl"

// References only: source provisioning and runtime delivery are not yet enabled.
config {
  name = "demo"
  engine = "docker"
  secrets {
    new { name = "db-password" }
  }
  services {
    ["app"] {
      image = "alpine:3"
      secrets {
        new {
          name = "db-password"
          target = "/run/secrets/db-password"
        }
      }
    }
  }
}
