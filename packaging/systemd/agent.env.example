# Non-secret settings only. Install as /etc/dill-agent/agent.env (root:root, 0600).
# Keep loopback for a host-local client; for remote Brine use a literal private IP.
DILL_AGENT_LISTEN=127.0.0.1:8443
DILL_AGENT_ENGINE_SOCKET=/run/docker.sock
DILL_AGENT_ENGINE_ID=REPLACE_WITH_ENROLLED_ENGINE_UUID
DILL_AGENT_DAEMON_ID=REPLACE_WITH_OBSERVED_DOCKER_ID
DILL_AGENT_GENERATION=1
