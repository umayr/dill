[Unit]
Description=Dill private HTTPS host agent
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=exec
User=dillagent
Group=dillagent
EnvironmentFile=/etc/dill-agent/agent.env
ExecStart=/usr/local/bin/dill agent --https-dir /var/lib/dill-agent/https --https-listen ${DILL_AGENT_LISTEN} --engine-socket ${DILL_AGENT_ENGINE_SOCKET} --engine-id ${DILL_AGENT_ENGINE_ID} --daemon-id ${DILL_AGENT_DAEMON_ID} --generation ${DILL_AGENT_GENERATION}
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
